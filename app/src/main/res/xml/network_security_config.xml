<?xml version="1.0" encoding="utf-8"?>
<!--
  Some Steam CDN edge nodes are only reachable over plain HTTP. Depot chunks are AES-encrypted
  and verified against the manifest's SHA-1 checksums, so cleartext is acceptable for them.

  This has to be the base config: any <domain-config> makes Android's trust manager reject the
  non-hostname-aware certificate check that ktor's TLS (JavaSteam's WebSocket CM connections)
  uses, so every WebSocket connection to Steam failed. Everything else the app talks to (Steam
  login, Web API, images, GitHub) uses https:// URLs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
